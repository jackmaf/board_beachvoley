# =============================================================================
# Voley Playa Scout — archivos que NO deben subirse al repositorio
# La app no tiene build ni dependencias: aquí sólo hay ruido del sistema,
# del editor y archivos que la propia app genera al exportar.
# =============================================================================

# --- Exportaciones generadas por la app ------------------------------------
# Reportes de jugadores y copias de seguridad: contienen datos personales
# de jugadores y partidos, nunca deben acabar en git.
VoleyPlaya_Scouting_*.pdf
VoleyPlaya_Scouting_*.csv
VoleyPlaya_Scouting_*.json
VoleyPlaya_Backup_*.json

# --- Node (sólo se usa para `npm test`; si algún día hay dependencias) -------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
coverage/
.nyc_output/

# --- Variables de entorno y secretos ----------------------------------------
.env
.env.*

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
# Metadatos que Windows añade al copiar archivos dentro de WSL
*:Zone.Identifier

# --- Editores e IDEs --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Claude Code ------------------------------------------------------------
# Los agentes compartidos (.claude/agents/) SÍ se versionan;
# la configuración personal de cada desarrollador, no.
.claude/settings.local.json

# --- Temporales -------------------------------------------------------------
*.log
*.tmp
tmp/
